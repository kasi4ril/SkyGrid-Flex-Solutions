# ==============================================================================
# Growatt PAYG Enterprise - Environment Configuration Template
# ==============================================================================

# Core System
ENVIRONMENT=development
LOG_LEVEL=debug
SERVER_PORT=8080
JWT_SECRET=super_secret_jwt_hmac_sha256_token_key_change_in_production_2026

# Virtual File System (VFS) Root Directory
# Production default: /var/lib/payg-vfs
# Development default fallback: ./data/vfs
VFS_ROOT_PATH=/var/lib/payg-vfs

# Database (PostgreSQL 16 + TimescaleDB + pgvector)
POSTGRES_USER=payg_admin
POSTGRES_PASSWORD=payg_secure_pass_2026
POSTGRES_DB=payg_enterprise
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgres://payg_admin:payg_secure_pass_2026@localhost:5432/payg_enterprise?sslmode=disable

# EMQX 5 MQTT Broker
MQTT_BROKER_URL=tcp://localhost:1883
MQTT_CLIENT_ID=core_backend_gateway
MQTT_USERNAME=payg_service
MQTT_PASSWORD=payg_mqtt_secret_2026
EMQX_ADMIN_USER=admin
EMQX_ADMIN_PASS=public_emqx_2026

# Redis 7
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=payg_redis_secret_2026
REDIS_URL=redis://:payg_redis_secret_2026@localhost:6379/0

# Credit Clock & Heartbeat Cadence
CRON_EVAL_INTERVAL_MINUTES=5
HEARTBEAT_INTERVAL_MINUTES=15
GRACE_PERIOD_HOURS=48

# Multi-Rail Payment Gateways (Nigeria)
# Paystack
PAYSTACK_SECRET_KEY=sk_test_paystack_secret_key_mock_2026
PAYSTACK_PUBLIC_KEY=pk_test_paystack_public_key_mock_2026
PAYSTACK_WEBHOOK_SECRET=pstk_wh_secret_hmac512_verification_token

# Moniepoint DVA
MONIEPOINT_API_KEY=monie_test_api_key_mock_2026
MONIEPOINT_SECRET_KEY=monie_secret_key_mock_2026
MONIEPOINT_WEBHOOK_SECRET=monie_wh_hmac_secret_token

# OPay
OPAY_MERCHANT_ID=opay_merchant_id_2026
OPAY_SECRET_KEY=opay_secret_key_mock_2026
OPAY_WEBHOOK_SECRET=opay_webhook_secret_hmac

# Growatt Cloud OpenAPI V1 (Secondary verification fallback)
GROWATT_API_URL=https://openapi.growatt.com
GROWATT_API_KEY=mock_growatt_developer_api_key
GROWATT_SECRET_CODE=mock_growatt_secret_hash

# Python Intelligence Engine (gRPC & FastAPI)
INTELLIGENCE_ENGINE_URL=http://localhost:8000
INTELLIGENCE_ENGINE_GRPC=localhost:50051

# Open-Meteo & Weather
OPEN_METEO_API_URL=https://api.open-meteo.com/v1/forecast

# LLM Providers (Read-only LocalGridAgent RAG)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

